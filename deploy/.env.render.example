# Render: variables que debes completar al importar el Blueprint.
DATABASE_URL=mysql+pymysql://USUARIO:CLAVE_CODIFICADA@HOST_AIVEN:PUERTO/BASE?charset=utf8mb4
FRONTEND_ORIGIN=https://TU-FRONTEND.vercel.app
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_URL=https://TU-API.onrender.com/api/pagos/mercado-pago/webhook
MERCADOPAGO_RETURN_URL=https://TU-FRONTEND.vercel.app/mis-recibos

# Opcionales para acceso con Google y correo de recuperación.
GOOGLE_CLIENT_IDS=
SMTP_EMAIL=
SMTP_PASSWORD=
# Si usas otro servidor SMTP configura también MAIL_HOST y MAIL_PORT.
# El Blueprint genera SECRET_KEY y configura DB_SSL_CA, UPLOAD_ROOT,
# PAYMENTS_SIMULATED y PORTAL_FLOTAS_ACTIVO. Añade ca.pem como Secret File.
