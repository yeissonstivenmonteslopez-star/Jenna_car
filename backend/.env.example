
# Usa una sola configuración: DATABASE_URL tiene prioridad sobre DB_*.
# Desarrollo local sin MySQL: sqlite:///jenna_car.db
DATABASE_URL=mysql+pymysql://root:TU_CLAVE@127.0.0.1:3306/jenna_car?charset=utf8mb4
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jenna_car
DB_USER=root
DB_PASSWORD=
SECRET_KEY=cambia-esta-clave-en-produccion
FRONTEND_ORIGIN=*


GOOGLE_CLIENT_IDS=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com


MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=usuario@example.com
MAIL_PASSWORD=contrasena-o-clave-de-aplicacion
MAIL_FROM=Jenna Car <no-reply@example.com>
MAIL_USE_TLS=true
