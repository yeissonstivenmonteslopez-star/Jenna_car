
# Usa una sola configuración: DATABASE_URL tiene prioridad sobre DB_*.
DATABASE_URL=mysql+pymysql://root:TU_CLAVE@127.0.0.1:3306/jenna_car?charset=utf8mb4
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jenna_car
DB_USER=root
DB_PASSWORD=
SECRET_KEY=cambia-esta-clave-en-produccion
# Orígenes permitidos (separados por coma). Nunca uses '*' en producción.
# Si se deja vacío solo se permiten http://localhost:5173 y http://127.0.0.1:5173.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173


GOOGLE_CLIENT_IDS=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com


MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=usuario@example.com
MAIL_PASSWORD=contrasena-o-clave-de-aplicacion
MAIL_FROM=Jenna Car <no-reply@example.com>
MAIL_USE_TLS=true

# Gmail: usa la contraseña de aplicación de Google, con verificación en dos pasos.
# También se admiten SMTP_EMAIL y SMTP_PASSWORD para instalaciones existentes.
# Para SSL en puerto 465: MAIL_USE_SSL=true y MAIL_USE_TLS=false.
MAIL_USE_SSL=false

# Checkout Pro: credenciales del vendedor, nunca en el frontend.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Deben ser URLs públicas HTTPS. Activa eventos de tipo payment en Mercado Pago.
MERCADOPAGO_WEBHOOK_URL=https://api.tu-dominio.com/api/pagos/mercado-pago/webhook
MERCADOPAGO_RETURN_URL=https://tu-dominio.com/mis-recibos

# Activa true solo para demostraciones; false para el checkout real.
PAYMENTS_SIMULATED=false
