# Base de datos y aplicación
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/jenna_sql?charset=utf8mb4
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jenna_sql
DB_USER=root
DB_PASSWORD=
SECRET_KEY=cambia-esta-clave-en-produccion
FRONTEND_ORIGIN=*

# IDs de cliente OAuth 2.0 permitidos (separados por comas)
GOOGLE_CLIENT_IDS=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Correo SMTP necesario para recuperar contraseñas
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=usuario@example.com
MAIL_PASSWORD=contrasena-o-clave-de-aplicacion
MAIL_FROM=Jenna Car <no-reply@example.com>
MAIL_USE_TLS=true
